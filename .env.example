# Example of /etc/wireguard/installer.env
#
# install.sh writes this file itself from the flags you pass, so you normally
# never create it by hand. It is documented here for two cases:
#
#   1. You want to change a setting after installing. Edit the real file at
#      /etc/wireguard/installer.env, then apply it:
#
#          sudo wg-peer render                     # config-only changes
#          sudo systemctl restart wg-quick@wg0     # if you changed PORTS or WAN_IF
#
#   2. You want to pre-seed a server without putting secrets in your shell
#      history. Place this at /etc/wireguard/installer.env (mode 600) before
#      running install.sh, and it will be picked up:
#
#          sudo install -m 600 /dev/null /etc/wireguard/installer.env
#          sudo nano /etc/wireguard/installer.env
#          sudo bash install.sh
#
# The real file contains private credentials. Keep it mode 600, and never
# commit a filled-in copy to git.

# --- required -------------------------------------------------------------

# Bot token from @BotFather.
TG_BOT_TOKEN='123456789:AAExampleTokenReplaceMe'

# Target chat id. Negative for groups, positive for a direct message.
# Find it with:
#   curl -s "https://api.telegram.org/bot<TOKEN>/getUpdates" \
#     | jq '.result[-1].message.chat.id'
TG_CHAT_ID='-1001234567890'

# --- server identity ------------------------------------------------------

# Label shown in Telegram and used to name config files. Defaults to the
# public IP. Give each server a distinct name when you run several.
NODE_NAME='oracle1'

# Public address clients connect to. Auto-detected at install; set it
# explicitly if detection is wrong or you use a DNS name.
ENDPOINT='203.0.113.10'

# Outbound interface, used for the REDIRECT and MASQUERADE rules.
# Auto-detected via: ip route get 1.1.1.1
WAN_IF='enp0s6'

# --- client-facing settings ----------------------------------------------

# UDP ports clients may connect on. All reach the same server. The first one
# is the default written into new client configs.
# Your cloud firewall must allow every port listed here.
PORTS='53,9200,9201'

# 1 = accept clients on ANY UDP port, not just those in PORTS. Clients can then
# change the Endpoint port to anything. Requires the cloud firewall to allow all
# UDP ports (Oracle: leave the ingress destination port range empty).
# DHCP (67-68) stays exempt so the VM keeps its address.
# Changing this needs: sudo systemctl restart wg-quick@wg0
ANY_PORT='0'

# Tunnel subnet. Must be a /24. The server takes .1, clients start at .2.
WG_SUBNET='10.13.13.0/24'

# DNS pushed to clients.
CLIENT_DNS='1.1.1.1, 1.0.0.1'

# Client MTU. 1420 suits most links; lower it if you see stalls on
# connections that already involve tunnelling (some mobile networks).
MTU='1420'

# Name of the peer created at install time. Remembered so that a bare re-run
# of install.sh does not create a duplicate.
PEER_NAME='client'
